# What to start: `cpu` or `nvidia` (pick one, nvidia needs the NVIDIA Container Toolkit), plus `playground` for the browser UI.
COMPOSE_PROFILES=cpu,playground

# Port on the host used to reach the Kev API, for example http://localhost:8009.
KEV_API_HOST_PORT=8009

# Port on the host used to open the browser playground.
PLAYGROUND_HOST_PORT=3001

# Hub id of the model to serve: jaredpalmer/kev-{0.8b,4b,9b,27b}. 27B is bf16 only and needs an 80 GB+ NVIDIA GPU.
# See: https://huggingface.co/collections/jaredpalmer/kev
KEV_RUN=jaredpalmer/kev-9b

# Optional serving switches (leave empty for defaults). KEV_TRUNCATE_STATES=1 reads the first 65,536 tokens of a longer
# state instead of answering 422. KEV_FUSED / KEV_CUDA_GRAPHS=0 decline the NVIDIA fast paths. KEV_DTYPE=fp32 is the exact path.
KEV_TRUNCATE_STATES=
KEV_DTYPE=
KEV_BACKEND=
KEV_FUSED=
KEV_CUDA_GRAPHS=
KEV_PREFIX_CACHE=4

# Optional Hugging Face access token (for model downloads).
HF_TOKEN=

# Set to 1 to disable Next.js telemetry in the playground; 0 enables it.
NEXT_TELEMETRY_DISABLED=1

# Optional bearer token required for /v1 API requests for direct API clients. 
# Note: Leave empty when using the playground.  Playground does not support an API Key. 
KEV_API_KEY=